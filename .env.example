# Local development only. Production refuses this flag.
ALLOW_DEV_AUTH=1
NODE_ENV=development
PORT=3001
DATABASE_PATH=data/quiet-harbor.sqlite
# Exact browser origins, comma separated. Set the deployed HTTPS origin in production.
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For a development tunnel, append only its exact HTTPS origin to this development config.
# Never copy a temporary preview origin into the production allowlist.
# Required in production; never commit or expose this in a VITE_ variable.
TELEGRAM_BOT_TOKEN=
